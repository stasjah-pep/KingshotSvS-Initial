<?xml version="1.0" encoding="utf-8"?>
<!-- One floating overlay target "pill": small label + big countdown + progress bar.
     Background colour / accent / sizing are applied at runtime by FloatingOverlayService. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:minWidth="78dp"
    android:orientation="vertical"
    android:paddingLeft="11dp"
    android:paddingTop="6dp"
    android:paddingRight="11dp"
    android:paddingBottom="7dp"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.08"
        android:text="CSTL"
        android:textColor="#9AACAA"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/tvCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:text="4:12"
        android:textColor="#34C6D9"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/barTrack"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="6dp"
        android:background="#22FFFFFF"
        android:orientation="horizontal"
        android:weightSum="1">

        <View
            android:id="@+id/barFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.66"
            android:background="#34C6D9" />

        <View
            android:id="@+id/barGap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.34" />
    </LinearLayout>
</LinearLayout>
